# twinspark cluster configuration — edit for your environment, then
# `source scripts/twinspark.env` (all scripts source this automatically).
export HEAD_LAN_IP="${HEAD_LAN_IP:-192.168.1.10}"     # spark1 management-LAN IP
export PEER_LAN_IP="${PEER_LAN_IP:-192.168.1.11}"     # spark2 management-LAN IP
export PEER_QSFP_IP="${PEER_QSFP_IP:-10.0.0.2}"       # spark2 on the QSFP link
export PEER_USER="${PEER_USER:-$USER}"                # your user on spark2
export MODEL_DIR="${MODEL_DIR:-$HOME/models/DeepSeek-V4-Flash-0731}"
export IMG="${IMG:-ds0731-vllm:ray}"                  # anemll image + ray (see README)
# NIC/HCA names as enumerated on DGX Spark (verify with scripts/preflight.sh):
export MGMT_IFACE="${MGMT_IFACE:-enP7s7}"
export NCCL_HCAS="${NCCL_HCAS:-rocep1s0f0,roceP2p1s0f0}"
